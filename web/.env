# Supabase project for KeepOnCourse accounts (used in every build mode).
# Both values are public by design: the publishable key only works within the
# database's row-level security rules (supabase/schema.sql). Never put the
# service_role / secret key here or anywhere in the web app.
VITE_SUPABASE_URL=https://zehsfpjychsbkexrdscn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kzJIm8XqyeH-gK7JuUV25g_sB2gZZvg

# Optional: your donation page (Ko-fi, GitHub Sponsors, Buy Me a Coffee…), https only.
# When set, the app shows a "Support KeepOnCourse" link.
VITE_SUPPORT_URL=

# Optional: Cloudflare Web Analytics site token (32 hex characters) for
# cookie-free visitor counts. When set, the build adds Cloudflare's beacon,
# allows it in the security policy, and the privacy policy mentions it.
VITE_CF_ANALYTICS_TOKEN=6af5f9e8da0047e99d841dab9d6af31d
