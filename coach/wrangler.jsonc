{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codecrafthub-coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Origins allowed to call Coach. Add your GitHub Pages origin before deploying.
    "ALLOWED_ORIGINS": "https://keeponcourse.com,https://www.keeponcourse.com,https://unifosec.github.io,http://localhost:5173,http://localhost:4173",
    // Default model is claude-haiku-5-5 (fast, low cost). To use a more capable one:
    // "COACH_MODEL": "claude-opus-5-5",

    // Accounts (public values, same as the web app's). The Worker passes each
    // user's own sign-in token to the database, so no secret key is needed.
    "SUPABASE_URL": "https://zehsfpjychsbkexrdscn.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_kzJIm8XqyeH-gK7JuUV25g_sB2gZZvg",

    // Daily Coach allowances (reset at midnight UTC)
    "USER_DAILY_LIMIT": "60",
    "ANON_DAILY_LIMIT": "15"
  },
  // Anonymous visitors' daily counts, keyed by a one-way hash of IP + day
  "kv_namespaces": [{ "binding": "COACH_USAGE", "id": "c7e9a8c8ffed42ddbd9326f1facd8df3" }],
  // 10 chat requests per minute per visitor IP
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
  // The API key is a secret, never a var:  npx wrangler secret put ANTHROPIC_API_KEY
}
